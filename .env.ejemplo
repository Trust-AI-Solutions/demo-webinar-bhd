# Variables que se cargan en Render (Environment) o Netlify (Environment variables).
# Nunca escriba aquí los valores reales: viven en LastPass.
ANTHROPIC_API_KEY=        # Obligatoria. Entrada de LastPass: <nombre de la entrada>
CLAVE_DEMO=               # Opcional. Si se define, la demo pide esta clave antes de usar la IA.
MODELO_IA=                # Opcional. Por defecto claude-opus-5-5.
ESFUERZO_IA=              # Opcional. low (por defecto), medium o high.
ESFUERZO_DOCUMENTO=          # Opcional. Esfuerzo de los lectores de documentos: medium (por defecto) o high.
